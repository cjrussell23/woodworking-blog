# Postgres. Locally, a plain Postgres works; set POSTGRES_SSLMODE=disable.
# On Vercel these come from the Vercel Postgres (Neon) integration.
POSTGRES_HOST=localhost:5432
POSTGRES_DATABASE=woodworking_blog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
# Optional, only for hosts that require it (Neon uses "require")
# POSTGRES_CHANNELBINDING=require

# Used to sign Payload auth tokens. Any long random string.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob read/write token, for media uploads
BLOB_READ_WRITE_TOKEN=YOUR_BLOB_TOKEN_HERE

# Lets the Vercel cron call Payload's job runner
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Validates draft preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Shown in page titles and link previews
NEXT_PUBLIC_SITE_NAME=Woodworking Blog
